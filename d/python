async def create_embed(msg:discord.Message):
    reference:discord.Message=msg.reference and (msg.reference.cached_message or await msg.channel.fetch_message(msg.reference.message_id))
    user=msg.author
    new=discord.Embed()
    new.set_author(
        name="Mist (1393750878367776839)",
        icon_url=user.display_avatar
    )
    new.description=f"```{msg.content}```\n\nmsgid: {msg.id}"
    new.title=f"{user.display_name} / @{user.name}"
    if len(msg.attachments)!=0:
        new.set_image(url=msg.attachments[0].url)
    if reference:
        new.set_footer(
            text=f"replying to {reference.author.name}'s",
            icon_url=reference.author.display_avatar.url
        )
    return new



class client(discord.Client):
